{
  "rules": {
    ".read": false,
    ".write": false,
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "bookings": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        "$bookingId": {
          ".write": "auth != null && ((auth.uid === $uid && ((!data.exists() && newData.exists() && newData.child('status').val() === 'pending') || (data.exists() && data.child('status').val() === 'pending' && ((!newData.exists()) || (newData.child('status').val() === 'pending' && newData.child('emailStatus').val() === data.child('emailStatus').val() && newData.child('userId').val() === $uid && newData.child('bookingId').val() === $bookingId && newData.child('createdAt').val() === data.child('createdAt').val())))) || root.child('admins').child(auth.uid).val() === true)",
          ".validate": "!newData.exists() || newData.hasChildren(['bookingId','userId','customerName','customerEmail','customerPhone','customerCity','eventName','eventType','eventDate','eventTime','guestCount','eventCity','venuePreference','preferredVenue','eventBudget','servicePreference','eventRequirements','status','emailStatus','createdAt','updatedAt'])",
          "bookingId": {
            ".validate": "newData.isString() && newData.val() === $bookingId"
          },
          "userId": {
            ".validate": "newData.isString() && newData.val() === $uid"
          },
          "status": {
            ".validate": "newData.val() === 'pending' || (auth != null && root.child('admins').child(auth.uid).val() === true && (newData.val() === 'approved' || newData.val() === 'rejected'))"
          },
          "emailStatus": {
            ".validate": "newData.val() === 'not_sent' || newData.val() === 'sent'"
          },
          "createdAt": {
            ".validate": "newData.val() === data.val() || !data.exists()"
          },
          "updatedAt": {
            ".validate": "newData.exists()"
          },
          "$other": {
            ".validate": true
          }
        }
      }
    },
    "events": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "services": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "venues": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "locations": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "siteSettings": {
      "theme": {
        ".read": true,
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
      }
    },
    "contactEnquiries": {
      "$enquiryId": {
        ".write": "(!data.exists() && newData.exists()) || (auth != null && root.child('admins').child(auth.uid).val() === true)",
        ".validate": "!newData.exists() || newData.hasChildren(['name','email','phone','subject','subjectKey','message','status','emailStatus','createdAt','updatedAt'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100"
        },
        "email": {
          ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$/) && newData.val().length <= 254"
        },
        "phone": {
          ".validate": "newData.isString() && newData.val().length <= 30"
        },
        "subject": {
          ".validate": "newData.isString() && newData.val().length <= 100"
        },
        "subjectKey": {
          ".validate": "newData.isString() && newData.val().length <= 50"
        },
        "message": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 5000"
        },
        "status": {
          ".validate": "newData.val() === 'new' || (auth != null && root.child('admins').child(auth.uid).val() === true && (newData.val() === 'reviewed' || newData.val() === 'resolved'))"
        },
        "emailStatus": {
          ".validate": "newData.val() === 'pending' || newData.val() === 'sent' || newData.val() === 'failed'"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && (newData.val() === data.val() || !data.exists())"
        },
        "updatedAt": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": true
        }
      },
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "reviewSubmissions": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$reviewId": {
        ".write": "(auth != null && !data.exists() && newData.exists()) || (auth != null && root.child('admins').child(auth.uid).val() === true)",
        ".validate": "!newData.exists() || newData.hasChildren(['name','review','rating','status','createdAt'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60"
        },
        "review": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 700"
        },
        "rating": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 5"
        },
        "photoURL": {
          ".validate": "newData.isString() && newData.val().length <= 2048"
        },
        "photoPath": {
          ".validate": "newData.isString() && newData.val().length <= 300"
        },
        "status": {
          ".validate": "newData.val() === 'pending' || (auth != null && root.child('admins').child(auth.uid).val() === true && (newData.val() === 'published' || newData.val() === 'hidden'))"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && (newData.val() === data.val() || !data.exists())"
        },
        "$other": {
          ".validate": true
        }
      }
    },
    "publishedReviews": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".indexOn": [
        "publishedAt"
      ]
    }
  }
}
